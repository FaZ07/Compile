# COMPILE — environment

# Groq — powers the intent parser + the synthesis brain.
# Without it, COMPILE falls back to deterministic heuristics (demo still works).
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Anakin Wire — optional. When set, flips the trend layer (YC / Product Hunt /
# TechCrunch) from mock to live. All other sources hit real public APIs already.
WIRE_API_KEY=
WIRE_BASE_URL=https://anakin.io/v1/wire
